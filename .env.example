# Luxe Hotel - Environment Configuration
# Copy this file to .env and fill in your actual values

# === Cloudflare D1 Configuration ===
# No environment variables needed for D1 in frontend
# D1 is bound directly in wrangler.toml with binding name 'DB'
# D1 Database ID: 8322ba8b-4563-449a-8929-5b090ee6215f

# === Authentication ===
# JWT Secret - CHANGE THIS IN PRODUCTION!
# This is used to sign and verify authentication tokens
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# === API Configuration ===
VITE_API_URL=http://localhost:8788

# === Development Settings ===
VITE_ENVIRONMENT=development
